{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-home",
  // No Worker code: Vite builds a single page, and Workers' static assets
  // serve dist/.
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  // The site is home.chiji.tech alone; its workers.dev address would only
  // show the same page twice.
  "routes": [{ "pattern": "home.chiji.tech", "custom_domain": true }],
  "workers_dev": false
}
